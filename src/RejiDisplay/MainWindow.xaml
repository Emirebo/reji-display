<Window x:Class="RejiDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED Output Manager — RejiDisplay v0.2 (LED Layout &amp; Calibration)"
        Height="900" Width="1200"
        MinHeight="750" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34D399"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F87171"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBBF24"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Top Controls (Preset & Reserved Center) -->
            <RowDefinition Height="Auto"/>
            <!-- Output Cards Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Toolbar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="LED OUTPUT MANAGER" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="NovaStar VX2000 Pro Signal &amp; Layout Manager (v0.2)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔍 EKRANLARI NUMARALANDIR (IDENTIFY)" Style="{StaticResource SecondaryBtnStyle}" Click="BtnIdentify_Click" Margin="0,0,10,0"/>
                <Button Content="🛑 TÜM ÇIKIŞLARI DURDUR" Style="{StaticResource DangerBtnStyle}" Click="BtnStopAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. Venue Preset & Reserved Center Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Venue Preset Card -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🎪 VENUE PRESET:" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbVenuePresets" Style="{StaticResource ComboBoxStyle}" SelectionChanged="CmbVenuePresets_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- Reserved Center Display Card -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🖥️ REZERVE CENTER:" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbReservedCenter" Style="{StaticResource ComboBoxStyle}" SelectionChanged="CmbReservedCenter_SelectionChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Output Cards Grid (LEFT & RIGHT) -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT OUTPUT CARD -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="LEFT LED" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border x:Name="BadgeLeftStatus" HorizontalAlignment="Right" Background="#334155" CornerRadius="10" Padding="8,3">
                                <TextBlock x:Name="TxtLeftStatus" Text="INACTIVE" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                        </Grid>

                        <!-- Display Assignment Selector -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="Hedef Ekran (Physical Output):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbLeftDisplay" Style="{StaticResource ComboBoxStyle}" SelectionChanged="CmbLeftDisplay_SelectionChanged"/>
                        </StackPanel>

                        <!-- Interactive Draft Preview Zone -->
                        <Border Grid.Row="2" x:Name="DropZoneLeft" Background="#0F172A" BorderBrush="#334155" BorderThickness="2" CornerRadius="6"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZoneLeft_Drop" Margin="0,0,0,10">
                            <Canvas x:Name="CanvasLeftPreviewViewport" Background="#000000" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="PanelLeftDropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Canvas.Left="40" Canvas.Top="50">
                                    <TextBlock Text="🖼️" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Görseli sürükleyin" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Image x:Name="ImgLeftPreview" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                            </Canvas>
                        </Border>

                        <!-- Media Info -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtLeftMediaPath" Text="(Görsel seçilmedi)" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <!-- Layout Adjustments (Scale / Zoom / Offsets) -->
                        <Border Grid.Row="4" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DRAFT DÜZENLEME (LAYOUT ADJUSTMENTS)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                <!-- Scale Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RadioLeftFit" Content="Fit" GroupName="LeftScale" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioLeftScale_Checked"/>
                                    <RadioButton x:Name="RadioLeftFill" Content="Fill" GroupName="LeftScale" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioLeftScale_Checked"/>
                                    <RadioButton x:Name="RadioLeftStretch" Content="Stretch" GroupName="LeftScale" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioLeftScale_Checked"/>
                                    <RadioButton x:Name="RadioLeftCustom" Content="Custom" GroupName="LeftScale" Foreground="#F8FAFC" Checked="RadioLeftScale_Checked"/>
                                </StackPanel>

                                <!-- Zoom Slider -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zoom:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderLeftZoom" Minimum="10" Maximum="400" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderLeftLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtLeftZoom" Text="100%" FontSize="11" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset X Slider -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset X:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderLeftOffsetX" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderLeftLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtLeftOffsetX" Text="0 px" FontSize="11" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset Y Slider -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset Y:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderLeftOffsetY" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderLeftLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtLeftOffsetY" Text="0 px" FontSize="11" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Reset Layout Button -->
                                <Button Content="↺ Konumu Sıfırla" Style="{StaticResource SecondaryBtnStyle}" Padding="6,3" FontSize="11" HorizontalAlignment="Right" Click="BtnLeftResetLayout_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions & Apply Controls -->
                        <StackPanel Grid.Row="5" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnLeftApply" Content="▶ UYGULA (APPLY TO LIVE)" Style="{StaticResource ApplyBtnStyle}" Click="BtnLeftApply_Click"/>
                                <Button Grid.Column="2" x:Name="BtnLeftStop" Content="⏹ DURDUR (STOP)" Style="{StaticResource DangerBtnStyle}" Click="BtnLeftStop_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnLeftBlack" Content="⚫ SİYAH (BLACK)" Style="{StaticResource WarningBtnStyle}" Click="BtnLeftBlack_Click"/>
                                <CheckBox Grid.Column="2" x:Name="ChkLeftLiveSync" Content="Canlı Güncelle (Live Sync)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkLeftLiveSync_Changed" Unchecked="ChkLeftLiveSync_Changed"/>
                            </Grid>
                            <TextBlock x:Name="TxtLeftError" Text="" Foreground="#F87171" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Advanced Calibration Expander -->
                        <Expander Grid.Row="6" Header="⚙️ GELİŞMİŞ KALİBRASYON (ADVANCED CALIBRATION)" Foreground="{StaticResource TextSecondary}" FontSize="11">
                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                                <StackPanel x:Name="PanelLeftCalibration">
                                    <TextBlock Text="Logical LED Canvas (Physical Pixels):" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                        <TextBlock Text="Genişlik:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtLeftLedW" Text="860" Width="45" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtLeftCalibration_LostFocus"/>
                                        <TextBlock Text="px  Yükseklik:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox x:Name="TxtLeftLedH" Text="1720" Width="45" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtLeftCalibration_LostFocus"/>
                                        <TextBlock Text="px" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="GPU Viewport Offsets:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="X:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtLeftVpX" Text="0" Width="40" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtLeftCalibration_LostFocus"/>
                                        <TextBlock Text="Y:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox x:Name="TxtLeftVpY" Text="0" Width="40" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtLeftCalibration_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- RIGHT OUTPUT CARD -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="RIGHT LED" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border x:Name="BadgeRightStatus" HorizontalAlignment="Right" Background="#334155" CornerRadius="10" Padding="8,3">
                                <TextBlock x:Name="TxtRightStatus" Text="INACTIVE" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                        </Grid>

                        <!-- Display Assignment Selector -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="Hedef Ekran (Physical Output):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbRightDisplay" Style="{StaticResource ComboBoxStyle}" SelectionChanged="CmbRightDisplay_SelectionChanged"/>
                        </StackPanel>

                        <!-- Interactive Draft Preview Zone -->
                        <Border Grid.Row="2" x:Name="DropZoneRight" Background="#0F172A" BorderBrush="#334155" BorderThickness="2" CornerRadius="6"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZoneRight_Drop" Margin="0,0,0,10">
                            <Canvas x:Name="CanvasRightPreviewViewport" Background="#000000" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="PanelRightDropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Canvas.Left="40" Canvas.Top="50">
                                    <TextBlock Text="🖼️" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Görseli sürükleyin" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Image x:Name="ImgRightPreview" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                            </Canvas>
                        </Border>

                        <!-- Media Info -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtRightMediaPath" Text="(Görsel seçilmedi)" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <!-- Layout Adjustments (Scale / Zoom / Offsets) -->
                        <Border Grid.Row="4" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DRAFT DÜZENLEME (LAYOUT ADJUSTMENTS)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                <!-- Scale Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RadioRightFit" Content="Fit" GroupName="RightScale" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioRightScale_Checked"/>
                                    <RadioButton x:Name="RadioRightFill" Content="Fill" GroupName="RightScale" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioRightScale_Checked"/>
                                    <RadioButton x:Name="RadioRightStretch" Content="Stretch" GroupName="RightScale" Foreground="#F8FAFC" Margin="0,0,10,0" Checked="RadioRightScale_Checked"/>
                                    <RadioButton x:Name="RadioRightCustom" Content="Custom" GroupName="RightScale" Foreground="#F8FAFC" Checked="RadioRightScale_Checked"/>
                                </StackPanel>

                                <!-- Zoom Slider -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zoom:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderRightZoom" Minimum="10" Maximum="400" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderRightLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtRightZoom" Text="100%" FontSize="11" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset X Slider -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset X:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderRightOffsetX" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderRightLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtRightOffsetX" Text="0 px" FontSize="11" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset Y Slider -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset Y:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderRightOffsetY" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderRightLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtRightOffsetY" Text="0 px" FontSize="11" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Reset Layout Button -->
                                <Button Content="↺ Konumu Sıfırla" Style="{StaticResource SecondaryBtnStyle}" Padding="6,3" FontSize="11" HorizontalAlignment="Right" Click="BtnRightResetLayout_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions & Apply Controls -->
                        <StackPanel Grid.Row="5" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnRightApply" Content="▶ UYGULA (APPLY TO LIVE)" Style="{StaticResource ApplyBtnStyle}" Click="BtnRightApply_Click"/>
                                <Button Grid.Column="2" x:Name="BtnRightStop" Content="⏹ DURDUR (STOP)" Style="{StaticResource DangerBtnStyle}" Click="BtnRightStop_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnRightBlack" Content="⚫ SİYAH (BLACK)" Style="{StaticResource WarningBtnStyle}" Click="BtnRightBlack_Click"/>
                                <CheckBox Grid.Column="2" x:Name="ChkRightLiveSync" Content="Canlı Güncelle (Live Sync)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Checked="ChkRightLiveSync_Changed" Unchecked="ChkRightLiveSync_Changed"/>
                            </Grid>
                            <TextBlock x:Name="TxtRightError" Text="" Foreground="#F87171" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Advanced Calibration Expander -->
                        <Expander Grid.Row="6" Header="⚙️ GELİŞMİŞ KALİBRASYON (ADVANCED CALIBRATION)" Foreground="{StaticResource TextSecondary}" FontSize="11">
                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                                <StackPanel x:Name="PanelRightCalibration">
                                    <TextBlock Text="Logical LED Canvas (Physical Pixels):" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                        <TextBlock Text="Genişlik:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtRightLedW" Text="860" Width="45" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtRightCalibration_LostFocus"/>
                                        <TextBlock Text="px  Yükseklik:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox x:Name="TxtRightLedH" Text="1720" Width="45" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtRightCalibration_LostFocus"/>
                                        <TextBlock Text="px" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="GPU Viewport Offsets:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="X:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtRightVpX" Text="0" Width="40" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtRightCalibration_LostFocus"/>
                                        <TextBlock Text="Y:" FontSize="10" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox x:Name="TxtRightVpY" Text="0" Width="40" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" Padding="2" LostFocus="TxtRightCalibration_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="6" Padding="12,6">
            <Grid>
                <TextBlock x:Name="TxtGlobalStatus" Text="Sistem Hazır (v0.2). Düzenlemeleri önizleyin ve canlı yayına almak için UYGULA butonuna basın." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="RejiDisplay v0.2 | Antigravity IDE" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
            </Grid>
        </Border>
    </Grid>
</Window>
