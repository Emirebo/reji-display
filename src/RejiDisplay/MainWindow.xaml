<Window x:Class="RejiDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED Output Manager — RejiDisplay v0.2 (LED Layout &amp; Calibration)"
        Height="920" Width="1220"
        MinHeight="750" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F9FAFB">

    <Window.Resources>
        <!-- Reusable Dark Theme Palette -->
        <SolidColorBrush x:Key="MainBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="InputBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BorderDefault" Color="#475569"/>
        <SolidColorBrush x:Key="BorderAccent" Color="#38BDF8"/>
        
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>

        <!-- Primary Buttons -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34D399"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F87171"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBBF24"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Dark Theme ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Theme ComboBox Style & ControlTemplate -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- Toggle Button for DropDown -->
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1E293B"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selection Content Text -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <!-- DropDown Popup Menu -->
                            <Popup x:Name="PlacementPopup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border x:Name="DropDownBorder"
                                        Background="#1E293B"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding Path=ActualWidth, ElementName=MainGrid}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Top Controls (Preset & Reserved Center) -->
            <RowDefinition Height="Auto"/>
            <!-- Output Cards Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Toolbar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="LED OUTPUT MANAGER" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="NovaStar VX2000 Pro Signal &amp; Layout Manager (v0.2)" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔍 EKRANLARI NUMARALANDIR (IDENTIFY)" Style="{StaticResource SecondaryBtnStyle}" Click="BtnIdentify_Click" Margin="0,0,10,0"/>
                <Button Content="🛑 TÜM ÇIKIŞLARI DURDUR" Style="{StaticResource DangerBtnStyle}" Click="BtnStopAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. Venue Preset & Reserved Center Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Venue Preset Card -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🎪 VENUE PRESET:" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbVenuePresets" SelectionChanged="CmbVenuePresets_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- Reserved Center Display Card -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🖥️ REZERVE CENTER:" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbReservedCenter" SelectionChanged="CmbReservedCenter_SelectionChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Output Cards Grid (LEFT & RIGHT) -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT OUTPUT CARD -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="LEFT LED" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border x:Name="BadgeLeftStatus" HorizontalAlignment="Right" Background="#334155" CornerRadius="10" Padding="10,4">
                                <TextBlock x:Name="TxtLeftStatus" Text="INACTIVE" FontWeight="Bold" FontSize="12" Foreground="#CBD5E1"/>
                            </Border>
                        </Grid>

                        <!-- Display Assignment Selector -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Hedef Ekran (Physical Output):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbLeftDisplay" SelectionChanged="CmbLeftDisplay_SelectionChanged"/>
                        </StackPanel>

                        <!-- Interactive Draft Preview Zone -->
                        <Border Grid.Row="2" x:Name="DropZoneLeft" Background="#0F172A" BorderBrush="#475569" BorderThickness="2" CornerRadius="6"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZoneLeft_Drop" Margin="0,0,0,12">
                            <Canvas x:Name="CanvasLeftPreviewViewport" Background="#000000" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="PanelLeftDropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Canvas.Left="35" Canvas.Top="50">
                                    <TextBlock Text="🖼️" FontSize="34" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Görseli buraya sürükleyin" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Image x:Name="ImgLeftPreview" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                            </Canvas>
                        </Border>

                        <!-- Media Info & Test Pattern Actions -->
                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLeftMediaPath" Text="(Görsel seçilmedi)" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F9FAFC" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnLeftTestPattern" Content="🎯 TEST PATTERN" Style="{StaticResource SecondaryBtnStyle}" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnLeftTestPattern_Click"/>
                                <Button x:Name="BtnLeftRestoreMedia" Content="↺ Önceki Görsel" Style="{StaticResource SecondaryBtnStyle}" Padding="6,4" FontSize="11" Margin="4,0,0,0" Visibility="Collapsed" Click="BtnLeftRestoreMedia_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Layout Adjustments (Scale / Zoom / Offsets) -->
                        <Border Grid.Row="4" Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DRAFT DÜZENLEME (LAYOUT ADJUSTMENTS)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <!-- Scale Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioLeftFit" Content="Fit" GroupName="LeftScale" IsChecked="True" Foreground="#F9FAFC" FontSize="13" Margin="0,0,12,0" Checked="RadioLeftScale_Checked"/>
                                    <RadioButton x:Name="RadioLeftFill" Content="Fill" GroupName="LeftScale" Foreground="#F9FAFC" FontSize="13" Margin="0,0,12,0" Checked="RadioLeftScale_Checked"/>
                                    <RadioButton x:Name="RadioLeftStretch" Content="Stretch" GroupName="LeftScale" Foreground="#F9FAFC" FontSize="13" Margin="0,0,12,0" Checked="RadioLeftScale_Checked"/>
                                    <RadioButton x:Name="RadioLeftCustom" Content="Custom" GroupName="LeftScale" Foreground="#F9FAFC" FontSize="13" Checked="RadioLeftScale_Checked"/>
                                </StackPanel>

                                <!-- Zoom Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zoom:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderLeftZoom" Minimum="10" Maximum="400" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderLeftLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtLeftZoom" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#F9FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset X Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset X:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderLeftOffsetX" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderLeftLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtLeftOffsetX" Text="0 px" FontSize="12" FontWeight="Bold" Foreground="#F9FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset Y Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset Y:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderLeftOffsetY" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderLeftLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtLeftOffsetY" Text="0 px" FontSize="12" FontWeight="Bold" Foreground="#F9FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Reset Layout Button -->
                                <Button Content="↺ Konumu Sıfırla" Style="{StaticResource SecondaryBtnStyle}" Padding="8,4" FontSize="12" HorizontalAlignment="Right" Click="BtnLeftResetLayout_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions & Apply Controls -->
                        <StackPanel Grid.Row="5" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnLeftApply" Content="▶ UYGULA (APPLY TO LIVE)" Style="{StaticResource ApplyBtnStyle}" Click="BtnLeftApply_Click"/>
                                <Button Grid.Column="2" x:Name="BtnLeftStop" Content="⏹ DURDUR (STOP)" Style="{StaticResource DangerBtnStyle}" Click="BtnLeftStop_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnLeftBlack" Content="⚫ SİYAH (BLACK)" Style="{StaticResource WarningBtnStyle}" Click="BtnLeftBlack_Click"/>
                                <CheckBox Grid.Column="2" x:Name="ChkLeftLiveSync" Content="Canlı Güncelle (Live Sync)" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Checked="ChkLeftLiveSync_Changed" Unchecked="ChkLeftLiveSync_Changed"/>
                            </Grid>
                            <TextBlock x:Name="TxtLeftError" Text="" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Advanced Calibration Expander -->
                        <Expander Grid.Row="6" Header="⚙️ GELİŞMİŞ KALİBRASYON (ADVANCED CALIBRATION)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold">
                            <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                <StackPanel x:Name="PanelLeftCalibration">
                                    <TextBlock Text="Logical LED Canvas (Physical Pixels):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBlock Text="Genişlik:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtLeftLedW" Text="860" Width="55" LostFocus="TxtLeftCalibration_LostFocus"/>
                                        <TextBlock Text="px  Yükseklik:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox x:Name="TxtLeftLedH" Text="1720" Width="55" LostFocus="TxtLeftCalibration_LostFocus"/>
                                        <TextBlock Text="px" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="GPU Viewport Offsets:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="X:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtLeftVpX" Text="0" Width="50" LostFocus="TxtLeftCalibration_LostFocus"/>
                                        <TextBlock Text="Y:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox x:Name="TxtLeftVpY" Text="0" Width="50" LostFocus="TxtLeftCalibration_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- RIGHT OUTPUT CARD -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="RIGHT LED" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border x:Name="BadgeRightStatus" HorizontalAlignment="Right" Background="#334155" CornerRadius="10" Padding="10,4">
                                <TextBlock x:Name="TxtRightStatus" Text="INACTIVE" FontWeight="Bold" FontSize="12" Foreground="#CBD5E1"/>
                            </Border>
                        </Grid>

                        <!-- Display Assignment Selector -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Hedef Ekran (Physical Output):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbRightDisplay" SelectionChanged="CmbRightDisplay_SelectionChanged"/>
                        </StackPanel>

                        <!-- Interactive Draft Preview Zone -->
                        <Border Grid.Row="2" x:Name="DropZoneRight" Background="#0F172A" BorderBrush="#475569" BorderThickness="2" CornerRadius="6"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZoneRight_Drop" Margin="0,0,0,12">
                            <Canvas x:Name="CanvasRightPreviewViewport" Background="#000000" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="PanelRightDropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Canvas.Left="35" Canvas.Top="50">
                                    <TextBlock Text="🖼️" FontSize="34" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Görseli buraya sürükleyin" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Image x:Name="ImgRightPreview" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                            </Canvas>
                        </Border>

                        <!-- Media Info & Test Pattern Actions -->
                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtRightMediaPath" Text="(Görsel seçilmedi)" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F9FAFC" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnRightTestPattern" Content="🎯 TEST PATTERN" Style="{StaticResource SecondaryBtnStyle}" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnRightTestPattern_Click"/>
                                <Button x:Name="BtnRightRestoreMedia" Content="↺ Önceki Görsel" Style="{StaticResource SecondaryBtnStyle}" Padding="6,4" FontSize="11" Margin="4,0,0,0" Visibility="Collapsed" Click="BtnRightRestoreMedia_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Layout Adjustments (Scale / Zoom / Offsets) -->
                        <Border Grid.Row="4" Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DRAFT DÜZENLEME (LAYOUT ADJUSTMENTS)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <!-- Scale Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioRightFit" Content="Fit" GroupName="RightScale" IsChecked="True" Foreground="#F9FAFC" FontSize="13" Margin="0,0,12,0" Checked="RadioRightScale_Checked"/>
                                    <RadioButton x:Name="RadioRightFill" Content="Fill" GroupName="RightScale" Foreground="#F9FAFC" FontSize="13" Margin="0,0,12,0" Checked="RadioRightScale_Checked"/>
                                    <RadioButton x:Name="RadioRightStretch" Content="Stretch" GroupName="RightScale" Foreground="#F9FAFC" FontSize="13" Margin="0,0,12,0" Checked="RadioRightScale_Checked"/>
                                    <RadioButton x:Name="RadioRightCustom" Content="Custom" GroupName="RightScale" Foreground="#F9FAFC" FontSize="13" Checked="RadioRightScale_Checked"/>
                                </StackPanel>

                                <!-- Zoom Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zoom:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderRightZoom" Minimum="10" Maximum="400" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderRightLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtRightZoom" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#F9FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset X Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset X:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderRightOffsetX" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderRightLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtRightOffsetX" Text="0 px" FontSize="12" FontWeight="Bold" Foreground="#F9FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Offset Y Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset Y:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderRightOffsetY" Minimum="-500" Maximum="500" Value="0" ValueChanged="SliderRightLayout_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtRightOffsetY" Text="0 px" FontSize="12" FontWeight="Bold" Foreground="#F9FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Reset Layout Button -->
                                <Button Content="↺ Konumu Sıfırla" Style="{StaticResource SecondaryBtnStyle}" Padding="8,4" FontSize="12" HorizontalAlignment="Right" Click="BtnRightResetLayout_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions & Apply Controls -->
                        <StackPanel Grid.Row="5" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnRightApply" Content="▶ UYGULA (APPLY TO LIVE)" Style="{StaticResource ApplyBtnStyle}" Click="BtnRightApply_Click"/>
                                <Button Grid.Column="2" x:Name="BtnRightStop" Content="⏹ DURDUR (STOP)" Style="{StaticResource DangerBtnStyle}" Click="BtnRightStop_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnRightBlack" Content="⚫ SİYAH (BLACK)" Style="{StaticResource WarningBtnStyle}" Click="BtnRightBlack_Click"/>
                                <CheckBox Grid.Column="2" x:Name="ChkRightLiveSync" Content="Canlı Güncelle (Live Sync)" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Checked="ChkRightLiveSync_Changed" Unchecked="ChkRightLiveSync_Changed"/>
                            </Grid>
                            <TextBlock x:Name="TxtRightError" Text="" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Advanced Calibration Expander -->
                        <Expander Grid.Row="6" Header="⚙️ GELİŞMİŞ KALİBRASYON (ADVANCED CALIBRATION)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold">
                            <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                <StackPanel x:Name="PanelRightCalibration">
                                    <TextBlock Text="Logical LED Canvas (Physical Pixels):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBlock Text="Genişlik:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtRightLedW" Text="860" Width="55" LostFocus="TxtRightCalibration_LostFocus"/>
                                        <TextBlock Text="px  Yükseklik:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox x:Name="TxtRightLedH" Text="1720" Width="55" LostFocus="TxtRightCalibration_LostFocus"/>
                                        <TextBlock Text="px" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="GPU Viewport Offsets:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="X:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtRightVpX" Text="0" Width="50" LostFocus="TxtRightCalibration_LostFocus"/>
                                        <TextBlock Text="Y:" FontSize="11" Foreground="#F9FAFC" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox x:Name="TxtRightVpY" Text="0" Width="50" LostFocus="TxtRightCalibration_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="6" Padding="12,8">
            <Grid>
                <TextBlock x:Name="TxtGlobalStatus" Text="Sistem Hazır (v0.2). Düzenlemeleri önizleyin ve canlı yayına almak için UYGULA butonuna basın." FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="RejiDisplay v0.2 | Antigravity IDE" HorizontalAlignment="Right" FontSize="12" Foreground="#64748B"/>
            </Grid>
        </Border>
    </Grid>
</Window>
